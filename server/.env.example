PORT=5000

# The connection string from MongoDB Atlas.
# NOTE THE NAME: the code reads MONGODB_URI. This file used to say MONGO_URI,
# which silently resolved to undefined and failed at connect time.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Which database inside the cluster to use.
DB_NAME=ultimate_car_detailing

# The client app's URL(s) allowed to call this API — comma separated.
# In production this MUST include the deployed frontend origin, e.g.
# CLIENT_ORIGINS=https://ultimatecardetailing.ca,https://www.ultimatecardetailing.ca
# A missing origin here is the usual cause of "failed to fetch" after deploying.
CLIENT_ORIGINS=http://localhost:5173

# Signs admin login tokens — make this a long random string.
# Changing it invalidates every issued token, logging all admins out.
JWT_SECRET=change-this-to-a-long-random-string

# The business's timezone. The dashboard's "last 30 days" chart buckets
# bookings by this calendar day rather than the server's, so a 9pm Toronto
# booking lands on the right bar. Defaults to America/Toronto if unset.
TIMEZONE=America/Toronto

# Used only when creating the first admin login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Gmail only (Nodemailer). GMAIL_USER is the Gmail address sending the
# email. GMAIL_APP_PASSWORD is NOT your real Gmail password — it's a
# 16-character App Password. Steps: myaccount.google.com/security -> turn
# on 2-Step Verification -> myaccount.google.com/apppasswords -> create
# one -> paste it here (remove the spaces).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Where new-booking alerts get sent (the client's email — can be the
# same as GMAIL_USER, or different).
NOTIFY_EMAIL=client@example.com
