# The API's base URL — no trailing slash.
#
# Local development:
#   VITE_API_URL=http://localhost:5000
#
# Production: set this in Vercel under Settings -> Environment Variables to
# your deployed API, e.g. https://ultimate-car-detailing-api.onrender.com
#
# Vite inlines this at BUILD time, not run time. Changing it in Vercel does
# nothing until you redeploy — that trips people up every time.
VITE_API_URL=http://localhost:5000
